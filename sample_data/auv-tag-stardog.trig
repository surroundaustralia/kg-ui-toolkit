      <http://www.opengis.net/def/metamodel/isodqm/formula> <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT51_1> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT51_2> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT51_3> .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD52> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD52" ;
      <http://www.w3.org/2004/02/skos/core#definition> "A manner of calculating the comparison of the data (measured) and the control (true)." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD52" ;
      <http://www.opengis.net/def/metamodel/isodqm/formula> <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT52_1> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT52_2> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT52_3> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT52_4> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT52_5> .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD53> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD53" ;
      <http://www.w3.org/2004/02/skos/core#definition> "A manner of calculating the comparison of the data (measured) and the control (true)." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD53" ;
      <http://www.opengis.net/def/metamodel/isodqm/formula> <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_1> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_2> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_3> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_4> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_5> , <https://standards.isotc211.org/19157/-3/1/dqc/content/formulaType/FT53_6> .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD5e> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD5e" ;
      <http://www.w3.org/2004/02/skos/core#definition> """A data product specification requires all towers higher than 300 m to be captured. The data quality measure “missing item” allows a data quality evaluator or a data user to report that a specific item, in this case a feature of type “tower” (name depends on the application schema), is missing.
Data quality scope: all towers with height > 300
Example result of a completeness evaluation of a particular data set:
missing item = true for
tower.name = “Eiffel Tower, Paris, France\"
tower.name = “Beijing Tower, Beijing, China”""" ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD5e" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD6> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD6" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Count number of item not present in the dataset which exists in the universe of discourse." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD6" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD60> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD60" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Number of incorrectly classified features compared to the specification. Features and the classification method as defined in the specification." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD60" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD61> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD61" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Number of incorrectly classified features compared to the specification. Features and the classification method as defined in the specification." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD61" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD62> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD62" ;
      <http://www.w3.org/2004/02/skos/core#definition> """The misclassification matrix (MCM) is a quadratic matrix with n columns and n rows. n denotes the number of classes under consideration.

MCM (i,j) = [# items of class (i) classified as class (j)] The diagonal elements of the misclassification matrix contain the correctly classified items, and the off diagonal elements contain the number of misclassification errors.""" ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD62" ;
      <http://xmlns.com/foaf/0.1/depiction> <https://ogcincubator.github.io/iso19157-3-dqm-register/ISO19157-3/img/62.png> .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD62e> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD62e" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Example misclassification matrix." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD62e" ;
      <http://xmlns.com/foaf/0.1/depiction> <https://ogcincubator.github.io/iso19157-3-dqm-register/ISO19157-3/img/62e.png> .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD63> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD63" ;
      <http://www.w3.org/2004/02/skos/core#definition> """The relative misclassification matrix (RMCM) is a quadratic matrix with n columns and n rows. n denotes the number of classes under consideration.
