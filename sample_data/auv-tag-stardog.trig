      <http://www.w3.org/2004/02/skos/core#notation> "MD16" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD17> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD17" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Conceptual schema describes valid values in the domain." ;
