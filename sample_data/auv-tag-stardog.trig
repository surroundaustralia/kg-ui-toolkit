{
    dct:contributor a rdf:Property ;
      rdfs:label "Contributor"@en ;
      rdfs:comment "An entity responsible for making contributions to the resource."@en ;
      dct:description "The guidelines for using names of persons or organizations as creators apply to contributors."@en ;
      rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/contributor> ;
      dct:issued "2008-01-14"^^xsd:date ;
      <http://purl.org/dc/dcam/rangeIncludes> dct:Agent .
}

