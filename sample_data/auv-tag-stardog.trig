      <http://www.w3.org/2004/02/skos/core#prefLabel> "ORM"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "operational risk management"@en .
    jmap_abbr:pir a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "PIR"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "PIR"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "priority intelligence requirement"@en .
    jmap_abbr:pme a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "PME"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "PME"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "professional military education"@en .
    jmap_abbr:rap a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "RAP"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "RAP"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "recognised air picture"@en .
    jmap_abbr:rasp a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "RASP"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "RASP"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "recognised air and surface picture"@en .
    jmap_abbr:rfi a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "RFI"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "RFI"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "request for information/intelligence"@en .
    jmap_abbr:rmp a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "RMP"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "RMP"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "recognised maritime picture"@en .
    jmap_abbr:roc a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "ROC"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "ROC"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "rehearsal of concept"@en .
    jmap_abbr:roe a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "ROE"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "ROE"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "rules of engagement"@en .
    jmap_abbr:sofa a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "SOFA"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "SOFA"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Status of Forces Agreement"@en .
    jmap_abbr:sop a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "SOP"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "SOP"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "standard operating procedures"@en .
    jmap_abbr:srp a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "SRP"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "SRP"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "standing risk profiles"@en .
    jmap_abbr:tai a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "TAI"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "TAI"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "target area of interest"@en .
}

<http://example.surroundaustralia.com/glossary/jmap_terms/> {
    <http://example.surroundaustralia.com/glossary/jmap_terms/> a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
      rdfs:label "JMAP Glossary Terms"@en ;
      dct:publisher "https://orcid.org/0009-0007-8434-7325"^^xsd:anyURI ;
      rdfs:comment "JMAP Glossary Terms mined from https://theforge.defence.gov.au/jmap/jmap-glossary"@en ;
      <http://www.w3.org/2004/02/skos/core#hasTopConcept> jmap_terms:adversary , jmap_terms:alertorderalerto , jmap_terms:areaofintelligenceinterestaii , jmap_terms:assumption , jmap_terms:block , jmap_terms:branch , jmap_terms:breach , jmap_terms:campaign , jmap_terms:canalise , jmap_terms:capture , jmap_terms:ceaseorderceaseo , jmap_terms:centreofgravitycog , jmap_terms:clear , jmap_terms:coerce , jmap_terms:collectionplan , jmap_terms:commanderscriticalinformationrequirementsccir , jmap_terms:commandersdecisionpointcdp , jmap_terms:commandersintent , jmap_terms:comprehensiveapproach , jmap_terms:conceptofoperationsconops , jmap_terms:contain , jmap_terms:control , jmap_terms:courseofactioncoa , jmap_terms:criticalcapabilitycc , jmap_terms:criticalfactorcf , jmap_terms:criticalrequirementcr , jmap_terms:criticalvulnerabilitycv , jmap_terms:culminatingpoint , jmap_terms:decisivepointdp , jmap_terms:defeat , jmap_terms:defend , jmap_terms:degrade , jmap_terms:delay , jmap_terms:deny , jmap_terms:destroy , jmap_terms:deter , jmap_terms:dislocate , jmap_terms:disrupt , jmap_terms:effect , jmap_terms:endstate , jmap_terms:essentialelementsoffriendlyinformationeefi , jmap_terms:essentialtask , jmap_terms:executeorderexecuto , jmap_terms:friendlyforceinformationrequirementffir , jmap_terms:highvaluetargethvt , jmap_terms:impliedtask , jmap_terms:interdict , jmap_terms:isolate , jmap_terms:jointintelligencepreparationoftheoperationalenvironmentjipoe , jmap_terms:jointj , jmap_terms:lineofcommunicationloc , jmap_terms:lineofoperationloo , jmap_terms:maineffortme , jmap_terms:mastertargetlistmtl , jmap_terms:missionmsn , jmap_terms:multinationalmn , jmap_terms:namedareaofinterestnai , jmap_terms:neutralise , jmap_terms:operationalartopart , jmap_terms:operationaldesign , jmap_terms:operationallevel , jmap_terms:operationalobjective , jmap_terms:operationalreach , jmap_terms:operationinstructionopinst , jmap_terms:operationop , jmap_terms:operationorderopord , jmap_terms:operationplanoplan , jmap_terms:penetrate , jmap_terms:phase , jmap_terms:prevent , jmap_terms:priorityintelligencerequirementpir , jmap_terms:protect , jmap_terms:retain , jmap_terms:rulesofengagementroe , jmap_terms:secure , jmap_terms:seize , jmap_terms:sequel , jmap_terms:sequencing , jmap_terms:shape , jmap_terms:specifiedtask , jmap_terms:stabilise , jmap_terms:strategiclevel , jmap_terms:supportingplan , jmap_terms:suppress , jmap_terms:synchronisation , jmap_terms:tacticallevel , jmap_terms:target , jmap_terms:targetareaofinteresttai , jmap_terms:undermine , jmap_terms:wargame , jmap_terms:warningorderwngo ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "JMAP Glossary Terms"@en ;
      so:dateCreated "2024-09-12T22:34:30.394194"^^xsd:dateTime .
    jmap_terms:adversary a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "adversary"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "adversary"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A party acknowledged as potentially hostile to a friendly party and against which the use of force may be envisaged."@en .
    jmap_terms:alertorderalerto a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "alert order (alerto)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "alert order (alerto)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Directs Service Chiefs to force assign force elements to an operation. Notes:1. Draws upon a number of strategic planning documents including the Chief of Defence Force (CDF) Planning Directive and CDF Warning Order.2. If a warning order has not been issued, the alert order initiates operational planning."@en .
    jmap_terms:areaofintelligenceinterestaii a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "area of intelligence interest (AII)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "area of intelligence interest (AII)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The area in which a commander requires intelligence on those factors and developments likely to affect the outcome of current and future operations."@en .
    jmap_terms:assumption a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "assumption"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "assumption"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A supposition on the current situation or a presupposition on the future course of events, either or both assumed to be true in the absence of positive proof, necessary to enable the commander in the process of planning to complete an estimate of the situation and make a decision on the course of action."@en .
    jmap_terms:block a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "block"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "block"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Deny access to an area or information, or prevent movement in a particular direction."@en .
    jmap_terms:branch a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "branch"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "branch"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An option at a commander’s decision point along a line of operation that allows the commander flexibility to anticipate decisive points by deviating from, and returning to, that line of operation."@en .
    jmap_terms:breach a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "breach"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "breach"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Break through an obstacle or defensive measures."@en .
    jmap_terms:campaign a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "campaign"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "campaign"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A set of military operations planned and conducted to achieve a strategic end state or objective within a given time and geographical area."@en .
    jmap_terms:canalise a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "canalise"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "canalise"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Restrict an adversary’s activities to a narrow area."@en .
    jmap_terms:capture a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "capture"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "capture"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Seize and retain an adversary’s personnel, equipment, infrastructure and information."@en .
    jmap_terms:ceaseorderceaseo a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "cease order (ceaseo)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "cease order (ceaseo)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An order to conclude military operations as directed."@en .
    jmap_terms:centreofgravitycog a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "centre of gravity (COG)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "centre of gravity (COG)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The primary entity that possesses the inherent capability to achieve an objective or the desired end state."@en .
    jmap_terms:clear a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "clear"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "clear"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Remove resistance or materiel from, and/or cause actors to leave, an area."@en .
    jmap_terms:coerce a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "coerce"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "coerce"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Compel an actor to adopt desired behaviours by threat of force."@en .
    jmap_terms:collectionplan a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "collection plan"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "collection plan"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A plan for collecting information from all available sources to meet collection requirements and for transforming those requirements into orders to collection elements."@en .
    jmap_terms:commanderscriticalinformationrequirementsccir a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "commander’s critical information requirements (CCIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "commander’s critical information requirements (CCIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The critical information a commander needs to make decisions. Note: CCIR comprise priority intelligence requirements, friendly force information requirements and essential elements of friendly information."@en .
    jmap_terms:commandersdecisionpointcdp a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "commander’s decision point (CDP)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "commander’s decision point (CDP)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A point in time and space at which a commander must make a decision in order to influence the operation in a particular target area of interest. Note: Must be offset from the point where the action has to take place, in order to allow sufficient lead-time for action to be initiated."@en .
    jmap_terms:commandersintent a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "commander’s intent"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "commander’s intent"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A formal statement, usually in the concept of operations or general outline of orders, given to provide clear direction of the commander’s intentions."@en .
    jmap_terms:comprehensiveapproach a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "comprehensive approach"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "comprehensive approach"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A multinational approach that responds effectively to complex crises by orchestrating, coordinating and de-conflicting military and non-military activities."@en .
    jmap_terms:conceptofoperationsconops a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "concept of operations (conops)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "concept of operations (conops)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A clear and concise statement of the line of action chosen by a commander in order to accomplish the mission."@en .
    jmap_terms:contain a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "contain"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "contain"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Restrict an actor’s movement to an area."@en .
    jmap_terms:control a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "control"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "control"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Persuade an actor to adopt desired behaviours, or maintain physical influence over an area to prevent its access and use."@en .
    jmap_terms:courseofactioncoa a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "course of action (COA)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "course of action (COA)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A possible plan that would achieve an objective or the desired end state."@en .
    jmap_terms:criticalcapabilitycc a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "critical capability (CC)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "critical capability (CC)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An action (verb) done by the centre of gravity which enables it to achieve an objective or the desired end state."@en .
    jmap_terms:criticalfactorcf a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "critical factor (CF)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "critical factor (CF)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A critical capability, critical requirement or critical vulnerability. Notes:1. Critical factors are identified during centre of gravity analysis.2. The key term is ‘critical’. A system may consist of many things, but few are likely to be critical."@en .
    jmap_terms:criticalrequirementcr a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "critical requirement (CR)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "critical requirement (CR)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A thing (noun), resource, or means that is essential for a critical capability to enable a centre of gravity to function."@en .
    jmap_terms:criticalvulnerabilitycv a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "critical vulnerability (CV)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "critical vulnerability (CV)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Those critical requirements, or components thereof, that are inherently targetable and vulnerable to neutralisation, defeat or destruction in a way that will contribute to undermining a centre of gravity."@en .
    jmap_terms:culminatingpoint a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "culminating point"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "culminating point"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The point in time and location where a force will no longer be stronger than the adversary and risks losing the initiative. Notes: 1. This may be due to reduced combat power, attrition, logistics, dwindling national will or other factors. 2. To be successful, the operation must achieve its objectives before reaching its culminating point."@en .
    jmap_terms:decisivepointdp a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "decisive point (DP)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "decisive point (DP)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A significant operational milestone that exists in time and space or the information domain which constitutes a key event, essential task, critical factor or function that, when executed or affected, allows a commander to gain a marked advantage, or contributes to achieving success."@en .
    jmap_terms:defeat a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "defeat"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "defeat"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Diminish the effectiveness of an adversary such that they are either unable or unwilling to achieve their objective."@en .
    jmap_terms:defend a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "defend"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "defend"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Repel an attack."@en .
    jmap_terms:degrade a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "degrade"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "degrade"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Reduce the effectiveness of a capability."@en .
    jmap_terms:delay a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "delay"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "delay"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Prevent an actor from arriving at a location before a specified time or event."@en .
    jmap_terms:deny a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "deny"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "deny"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Prevent an actor from using personnel, equipment, infrastructure and information."@en .
    jmap_terms:destroy a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "destroy"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "destroy"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Render an adversary or object permanently ineffective."@en .
    jmap_terms:deter a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "deter"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "deter"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Persuade an actor that the consequences of a course of action would outweigh potential gains."@en .
    jmap_terms:dislocate a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "dislocate"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "dislocate"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Render an actor’s capabilities irrelevant by not allowing them to be employed at a critical time and place."@en .
    jmap_terms:disrupt a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "disrupt"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "disrupt"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Reduce an actor’s ability to act as a coordinated whole."@en .
    jmap_terms:effect a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "effect"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "effect"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The consequence of an action or cause, which impacts physical, physiological, psychological or functional capabilities."@en .
    jmap_terms:endstate a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "end state"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "end state"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The political and/or military situation to be attained at the end of a campaign or operation, which indicates that the objective has been achieved."@en .
    jmap_terms:essentialelementsoffriendlyinformationeefi a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "essential elements of friendly information (EEFI)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "essential elements of friendly information (EEFI)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Critical exploitable information concerning friendly dispositions, intentions, capabilities, morale, knowledge and potential vulnerabilities that, if compromised, could threaten the success of friendly force."@en .
    jmap_terms:essentialtask a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "essential task"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "essential task"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A specified or implied task that an organisation must perform to accomplish the mission. Note: An essential task is typically included in the mission statement."@en .
    jmap_terms:executeorderexecuto a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "execute order (executo)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "execute order (executo)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An order to initiate military operations as directed."@en .
    jmap_terms:friendlyforceinformationrequirementffir a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "friendly force information requirement (FFIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "friendly force information requirement (FFIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Information regarding the activities or capabilities of own or adjacent units."@en .
    jmap_terms:highvaluetargethvt a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "high value target (HVT)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "high value target (HVT)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An asset which is likely to be required for completion of the adversary's mission."@en .
    jmap_terms:impliedtask a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "implied task"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "implied task"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A task derived during Mission Analysis that an organisation must perform or prepare to perform to accomplish a specified task or the mission, but which is not stated in the higher headquarters order."@en .
    jmap_terms:interdict a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "interdict"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "interdict"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Engage an adversary before they can affect friendly forces."@en .
    jmap_terms:isolate a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "isolate"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "isolate"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Separate an actor from their source of support and deny freedom of movement."@en .
    jmap_terms:jointintelligencepreparationoftheoperationalenvironmentjipoe a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "Joint Intelligence Preparation of the Operational Environment (JIPOE)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Joint Intelligence Preparation of the Operational Environment (JIPOE)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A systematic, dynamic process for analysing the threat and the environment, considered in the dimensions of space and time. Note: It is designed to support staff planning and prepare the foundations for informed military decision-making."@en .
    jmap_terms:jointj a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "joint (J)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "joint (J)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Activities, operations and organisations in which elements of at least two Services participate."@en .
    jmap_terms:lineofcommunicationloc a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "line of communication (LOC)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "line of communication (LOC)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A land, water or air route that connects an operating military force with one or more bases of operations, and along which supplies and reinforcements move."@en .
    jmap_terms:lineofoperationloo a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "line of operation (LOO)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "line of operation (LOO)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A line linking decisive points to allow sequential progression towards an operational objective or the desired end state."@en .
    jmap_terms:maineffortme a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "main effort (ME)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "main effort (ME)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A concentration of forces or means, in a particular area, time and phase of an operation, where a commander seeks to bring about a decision."@en .
    jmap_terms:mastertargetlistmtl a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "master target list (MTL)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "master target list (MTL)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The encompassed listings of targets designated for a campaign or operation, and comprise the joint target list, restricted target list and no-strike list."@en .
    jmap_terms:missionmsn a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "mission (msn)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "mission (msn)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A clear, concise statement of the task of the command and its purpose."@en .
    jmap_terms:multinationalmn a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "multinational (MN)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "multinational (MN)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Activities, operations and organisations, in which elements of more than one nation participate."@en .
    jmap_terms:namedareaofinterestnai a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "named area of interest (NAI)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "named area of interest (NAI)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A geographical area where information is gathered to satisfy specific intelligence requirements."@en .
    jmap_terms:neutralise a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "neutralise"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "neutralise"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Render an actor or objects temporarily ineffective."@en .
    jmap_terms:operationalartopart a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operational art (opart)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operational art (opart)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The skilful employment of military forces to attain strategic goals through the design, organisation, sequencing and direction of campaigns and operations. Notes:1. Operational art translates strategic into operational and ultimately tactical actions.2. It requires a commander to:a. identify the military conditions or end state that constitute the strategic objectiveb. decide the operational objectives that must be achieved to reach the desired end statec. order a sequence of actions that lead to fulfilment of the operational objectivesd. apply the military resources allocated to sustain the desired sequence of actions."@en .
    jmap_terms:operationaldesign a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operational design"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operational design"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The contemporary application of operational art in producing a schematic that represents the commander’s operational approach to a situation."@en .
    jmap_terms:operationallevel a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operational level"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operational level"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The level at which campaigns and operations are planned and conducted to accomplish strategic objectives."@en .
    jmap_terms:operationalobjective a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operational objective"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operational objective"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A condition that needs to be achieved during a campaign or operation to enable the desired end state to be reached. Note: Correct assessment of operational objectives is crucial to success at the operational level."@en .
    jmap_terms:operationalreach a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operational reach"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operational reach"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The distance and duration across which a force element can successfully employ its military capabilities."@en .
    jmap_terms:operationinstructionopinst a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operation instruction (opinst)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operation instruction (opinst)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Indicates the commander’s intention and possibly the overall plan but leaves the detailed course of action to the subordinate commander."@en .
    jmap_terms:operationop a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operation (op)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operation (op)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A series of tactical actions with a common unifying purpose, planned and conducted to achieve a strategic or campaign end state or objective within a given time and geographical area."@en .
    jmap_terms:operationorderopord a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operation order (opord)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operation order (opord)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A directive, usually formal, issued by a commander to subordinate commanders for the purpose of effecting the coordinated execution of an operation."@en .
    jmap_terms:operationplanoplan a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "operation plan (oplan)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "operation plan (oplan)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A plan for a single or series of connected operations to be carried out simultaneously or in succession. Notes:1. It is usually based upon stated assumptions and is the form of directive employed by higher authority to permit subordinate commanders to prepare supporting plans and orders.2. The designation ‘plan’ is usually used instead of ‘order’ in preparing for operations well in advance.3. An operation plan may be put into effect at a prescribed time, or on signal, and then becomes the operation order."@en .
    jmap_terms:penetrate a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "penetrate"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "penetrate"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Breach an adversary’s defence and affect their defensive system."@en .
    jmap_terms:phase a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "phase"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "phase"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A definitive stage of an operation or campaign during which a large portion of the forces and capabilities are involved in similar or mutually supporting activities for a common purpose."@en .
    jmap_terms:prevent a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "prevent"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "prevent"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Stop an action from occurring."@en .
    jmap_terms:priorityintelligencerequirementpir a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "priority intelligence requirement (PIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "priority intelligence requirement (PIR)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An intelligence requirement for which a commander has an anticipated and stated priority in the task of planning and decision making."@en .
    jmap_terms:protect a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "protect"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "protect"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Preserve the effectiveness of personnel, equipment, infrastructure and information."@en .
    jmap_terms:retain a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "retain"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "retain"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Maintain possession of personnel, equipment, infrastructure and information for friendly use."@en .
    jmap_terms:rulesofengagementroe a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "rules of engagement (ROE)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "rules of engagement (ROE)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Directives endorsed by Government and issued by commanders, which delineate the circumstances, and limitations within which military force may be applied to achieve military objectives. Notes:1. They do not inhibit or replace but are part of the command function.2. They may be framed to limit certain actions; alternatively, they may authorise actions to the full extent permissible under domestic and international law."@en .
    jmap_terms:secure a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "secure"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "secure"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Gain possession of and protect personnel, equipment, infrastructure and information."@en .
    jmap_terms:seize a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "seize"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "seize"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Gain possession of personnel, equipment, infrastructure and information by force."@en .
    jmap_terms:sequel a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "sequel"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "sequel"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An option at a commander’s decision point along a line of operation, initiated by a significant shift in operational direction, which identifies a new line of operation to achieve a revised or new objective."@en .
    jmap_terms:sequencing a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "sequencing"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "sequencing"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The ordering of decisive points into lines of operation, and the subsequent ordering of lines of operation into a logical progression in time, space and purpose."@en .
    jmap_terms:shape a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "shape"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "shape"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Enhance the friendly force's position, delay an adversary's response, or lead an adversary into an inadequate or inappropriate response to set the conditions for decisive action."@en .
    jmap_terms:specifiedtask a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "specified task"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "specified task"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A task that is specifically assigned to an organisation by its higher headquarters."@en .
    jmap_terms:stabilise a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "stabilise"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "stabilise"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Impose control and establish security over an area while restoring services and support to civilian agencies, which set the conditions to allow primacy of indigenous organisations."@en .
    jmap_terms:strategiclevel a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "strategic level"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "strategic level"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The level at which nations determine national or multinational security objectives and deploy national resources to achieve them."@en .
    jmap_terms:supportingplan a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "supporting plan"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "supporting plan"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A plan, complementing the main plan, which provides detailed information concerning specialised and discrete aspects of an operation, and may cover areas such as communications, electronic warfare, movement, administration, public information, and intelligence collection."@en .
    jmap_terms:suppress a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "suppress"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "suppress"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Temporarily degrade a capability."@en .
    jmap_terms:synchronisation a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "synchronisation"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "synchronisation"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The arrangement of related and mutually supporting actions in time, space and purpose to maximise their combined intended effects."@en .
    jmap_terms:tacticallevel a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "tactical level"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "tactical level"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The level at which activities, battles and engagements are planned and executed to accomplish military objectives assigned to tactical formations and units."@en .
    jmap_terms:target a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "target"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "target"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An entity or object which may be subject to an effect."@en .
    jmap_terms:targetareaofinteresttai a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "target area of interest (TAI)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "target area of interest (TAI)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A geographical point or area where key adversary capabilities are vulnerable to targeting by friendly forces."@en .
    jmap_terms:undermine a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "undermine"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "undermine"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Weaken an actor’s capabilities, morale, loyalty or reliability by affecting their military, cultural, economic, societal or political strength."@en .
    jmap_terms:wargame a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "war game"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "war game"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A simulation, by whatever means, of a military operation involving two or more forces (opposed or not) using rules, data, and procedures designed to depict an actual or assumed real life situation."@en .
    jmap_terms:warningorderwngo a owl:Class , <http://www.w3.org/2004/02/skos/core#Concept> ;
      rdfs:label "warning order (wngo)"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "warning order (wngo)"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A planning directive that describes the situation, allocates forces and resources, establishes command relationships, provides other initial planning guidance, and initiates subordinate unit mission planning."@en .
}

<http://example.surroundaustralia.com/ran/jmap/planning/> {
    jmap:MissionPlan a owl:Ontology ;
      rdfs:label "Mission Plan Ontology"@en ;
      dct:publisher "https://orcid.org/0009-0007-8434-7325"^^xsd:anyURI ;
      rdfs:comment """This is a simple ontology for RAN and Joint Military Planning for AUV missions applying JMAP.
    It includes links to JMAP glossary references (both glossary terms and abbreviations).

    Application of this ontology includes capture and classification of information that informs AUV decisions during mission planning."""@en ;
      so:dateCreated "2024-09-17"^^xsd:date ;
      dct:creator "https://orcid.org/0009-0007-8434-7325"^^xsd:anyURI ;
      dct:description "An ontology for RAN and Joint Military Planning for AUV missions applying JMAP"@en ;
      so:codeRepository <https://github.com/surroundaustralia/RAN> ;
      dct:source <https://theforge.defence.gov.au/sites/default/files/adfp_5.0.1_joint_military_appreciation_process_ed2_al3_1.pdf> .
}

{
    dct:creator a rdf:Property ;
      rdfs:label "Creator"@en ;
      rdfs:comment "An entity responsible for making the resource."@en ;
      dct:description "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en ;
      rdfs:isDefinedBy <http://purl.org/dc/terms/> ;
      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/creator> , dct:contributor ;
      dct:issued "2008-01-14"^^xsd:date ;
      <http://purl.org/dc/dcam/rangeIncludes> dct:Agent ;
      owl:equivalentProperty <http://xmlns.com/foaf/0.1/maker> .
    dct:description a rdf:Property ;
      rdfs:label "Description"@en ;
      rdfs:comment "An account of the resource."@en ;
