<tag:auv:path-test> {
    <https://surroundaustralia.com/demo/routeplanner/auv/AI-Route-Description-1> a <http://www.w3.org/ns/prov#Entity> ;
      rdfs:label "AI generated route suggestion" ;
      dct:abstract "Overall Risk Score: Moderate (3/5): This assessment is based on US naval risk acceptance guidelines, considering the likelihood and potential severity of various risks. The route balances efficiency with risk mitigation, but still involves significant challenges due to the long distance and complex maritime environment."^^rdf:HTML .
    <https://surroundaustralia.com/demo/routeplanner/auv/Perplexity-AI-Route-Assistant-q1> a <http://www.w3.org/ns/prov#Activity> ;
