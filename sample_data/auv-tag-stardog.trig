<tag:auv:path-test2> {
    <http://example.com/activities/router-q2> a <http://www.w3.org/ns/prov#Activity> ;
      rdfs:label "Router-q1" ;
      <http://www.w3.org/ns/prov#endedAtTime> "2029-01-01T22:05:19+02:00"^^xsd:dateTime ;
