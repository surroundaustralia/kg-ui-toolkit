      <http://www.w3.org/2004/02/skos/core#notation> "MD5" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD50> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD50" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Calculation of uncertainty ellipse parameters by eigenvalues from a given covariance matrix (https://standards.isotc211.org/19157/-1/1/dqc/content/qualityMeasure/32) of 2D point coordinates." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
