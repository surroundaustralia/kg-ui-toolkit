    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD1> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD1" ;
      <http://www.w3.org/2004/02/skos/core#definition> "The value true indicates that the item is in excess." ;
