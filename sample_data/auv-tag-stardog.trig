      <http://www.w3.org/2004/02/skos/core#notation> "MD1" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "ISO19157-3 Data Quality Measures (Extended Description Components)" ;
      <http://www.opengis.net/ogc-na#targetGraph> "https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD10> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD10" ;
      <http://www.w3.org/2004/02/skos/core#definition> "If the conceptual schema explicitly or implicitly describes rules, these rules shall be followed. Violations against such rules can be, for example, invalid placement of features within a defined tolerance, duplication of features and invalid overlap of features." ;
