    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD17e> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD17e" ;
      <http://www.w3.org/2004/02/skos/core#definition> "100 % (scope: attributes road width and speed limit for roads, are within the value domain)." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD17e" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD18> a <http://www.w3.org/2004/02/skos/core#Concept> ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "MD18" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Conceptual schema describes valid values in the domain." ;
      <http://www.w3.org/2004/02/skos/core#inScheme> <https://standards.isotc211.org/19157/-3/1/dqc/content/qualityMeasure> ;
      <http://www.w3.org/2004/02/skos/core#notation> "MD18" .
    <https://standards.isotc211.org/19157/-3/1/dqc/content/measureDescription/MD18e> a <http://www.w3.org/2004/02/skos/core#Concept> ;
